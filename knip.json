{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "backend": {
      "project": ["src/**/*.ts", "prisma/**/*.ts"]
    },
    "frontend": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@angular/router", "bootstrap"]
    },
    "shared": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
